+// a3 patch: a jump crossfades, a small move glides; a change during a crossfade waits for its end.
+void DualDelayAudioProcessor::a3HeadFor (int line, float newDelay)
+{
+    if (a3FadeLeft[line] > 0)
+        return;
+    const float headingFor = a3HeadingFor[line];
+    if (headingFor > 0.0f && std::abs (newDelay - headingFor) > a3::delay::crossfadeAboveRatio * headingFor)
+    {
+        a3FadeFrom[line] = a3Glided[line];
+        a3FadeLeft[line] = a3FadeLength;
+        delayTimeInterp[line].process (newDelay, true);   // the glide restarts at the new time
+    }
+    delayTimeInterp[line].setTargetValue (newDelay);
+    a3HeadingFor[line] = newDelay;
+}
