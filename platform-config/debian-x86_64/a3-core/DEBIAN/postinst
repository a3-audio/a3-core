#!/bin/sh
set -e

# Debconf helper
if [ -f /usr/share/debconf/confmodule ]; then
  . /usr/share/debconf/confmodule
fi

APPUSER="aaa"
UID=$(id -u $APPUSER)
USER_HOME=$(getent passwd "$APPUSER" | cut -d: -f6 || echo "/home/$APPUSER")

# Ask whether to configure network
db_input medium a3-core/configure-network || true
db_go || true
db_get a3-core/configure-network
CONFIGURE="$RET"

if [ "x$CONFIGURE" = "xtrue" ]; then
  # Check if user wants the standard/default network
  db_get a3-core/install-default-network
  INSTALL_DEFAULT="$RET"

  if [ "x$INSTALL_DEFAULT" = "xtrue" ]; then
    INTERFACE="eno1"
    ADDR="192.168.43.58/24"
    GATEWAY="192.168.43.1"
    DNS="192.168.43.1"
  else
    # Ask for details (will use template defaults if noninteractive)
    db_input medium a3-core/interface || true
    db_input medium a3-core/address || true
    db_input medium a3-core/gateway || true
    db_input medium a3-core/dns || true
    db_go || true

    db_get a3-core/interface; INTERFACE="$RET"
    db_get a3-core/address; ADDR="$RET"
    db_get a3-core/gateway; GATEWAY="$RET"
    db_get a3-core/dns; DNS="$RET"
  fi

  # Ensure target dir exists
  mkdir -p /etc/systemd/network

  # Atomic write of the network file
  tmpfile="$(mktemp /etc/systemd/network/a3.network.XXXXXX 2>/dev/null || mktemp /tmp/a3.network.XXXXXX)"
  cat > "$tmpfile" <<EOF
[Match]
Name=${INTERFACE}

[Network]
Address=${ADDR}
Gateway=${GATEWAY}
DNS=${DNS}
EOF
  chmod 644 "$tmpfile"
  chown root:root "$tmpfile"
  mv -f "$tmpfile" /etc/systemd/network/a3.network

  # Enable systemd-networkd unit but do NOT start it
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable systemd-networkd.service || true
  fi
fi

# Continue with original postinst tasks (venv, pip, chown, enable services, etc.)
# --- existing operations start ---
# (preserve previous behavior; adjust below if your original postinst differs)
python3 -m venv "${USER_HOME}/.venv" || true
"${USER_HOME}/.venv/bin/pip" install -r "${USER_HOME}/.local/share/a3-core/recipes/requirements.txt" || true

mkdir -p /home/aaa/.config
cp -rn /home/aaa/.local/share/a3-core/config/* /home/aaa/.config/

chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.local" || true
chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.config" || true
chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.ssh" || true

find "$USER_HOME/.config" -type d -exec chmod 0755 {} \;
find "$USER_HOME/.config" -type f -exec chmod 0664 {} \;

if [ -d /home/aaa/.ssh ]; then
  chmod 0700 /home/aaa/.ssh
  find /home/aaa/.ssh -type f -exec chmod 0600 {} \;
fi

echo "enable system services..."
systemctl daemon-reload || true
systemctl enable x11vnc.service || true
systemctl enable set_irq_prio.service || true

echo "enable userservices..."
# allow user services to run without an interactive session
loginctl enable-linger "${APPUSER}" || true

UID=$(id -u "$APPUSER")
XDG_RUNTIME_DIR="/run/user/$UID"
DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"

if sudo -u "$APPUSER" env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" systemctl --user daemon-reload; then
   # sudo -u "$APPUSER" env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" systemctl --user enable a3-main.service || true
    sudo -u "$APPUSER" env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" systemctl --user start a3-user-install.service || true
else
    echo "Failed to reload user daemon for $APPUSER"
fi

loginctl disable-linger "${APPUSER}" || true

echo "update grub..."
update-grub || true

echo "Installation complete."
echo "use 'systemctl --user status a3-user-install.service' to check status"
echo "use 'dpkg-reconfigure a3-core' to confirure network"
echo "use 'dpkg-reconfigure jackd2' to enable rt-priority"
echo "Please Reboot or manage a3-core manually with 'systemctl --user start a3-main.service'"
