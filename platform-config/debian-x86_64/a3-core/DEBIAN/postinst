#!/bin/sh
set -e

# Debconf helper
if [ -f /usr/share/debconf/confmodule ]; then
  . /usr/share/debconf/confmodule
fi
# ESC (back) in a dialog comes back from db_go as 30 instead of being taken as
# the pre-filled answer. The network step leaves on it (a3-core#68).
db_capb backup

APPUSER="aaa"
UID=$(id -u $APPUSER)
USER_HOME=$(getent passwd "$APPUSER" | cut -d: -f6 || echo "/home/$APPUSER")

# limits.d/audio.conf gives @audio realtime priority; on the rig aaa was put in
# the group by hand, on a fresh machine nobody did (a3-core#65). Takes effect
# at the next login.
join_audio_group() {
  case " $(id -nG "$1") " in
    *" audio "*) return 0 ;;
  esac
  usermod -aG audio "$1"
}

join_audio_group "$APPUSER"

# Take an interface out of ifupdown's hands, so systemd-networkd is the only
# thing that configures it. With both, /etc/network/interfaces' DHCP stanza and
# a3.network's static address claimed the same interface, and the address the
# machine came up with depended on which one was first (a3-core issue #54).
# Comments the lines out rather than deleting them, so the change can be read
# and undone. Idempotent: a commented line no longer matches.
disable_ifupdown_for() {
  iface="$1"
  file="$2"
  [ -f "$file" ] || return 0
  sed -i \
    -e "s/^\([[:space:]]*\(allow-hotplug\|auto\)[[:space:]]\+${iface}[[:space:]]*\)$/# a3-core: networkd owns ${iface} -- \1/" \
    -e "s/^\([[:space:]]*iface[[:space:]]\+${iface}[[:space:]].*\)$/# a3-core: networkd owns ${iface} -- \1/" \
    "$file"
}

# Put X on the dummy screen, or take it off again. The config used to ship as
# an active conffile, which on a machine with a screen is a black monitor with
# everything running behind it -- and dpkg re-installs a conffile that is new
# to the package even where somebody had moved it aside (a3-core issue #53).
# "No" takes the shipped config out of X by renaming it, which mends a machine
# the old package left it on; a config somebody wrote themselves is left alone.
apply_headless_choice() {
  choice="$1"
  shipped="$2"
  target="$3"
  if [ "x$choice" = "xtrue" ]; then
    mkdir -p "$(dirname "$target")"
    cp "$shipped" "$target"
    return 0
  fi
  if [ -f "$target" ] && cmp -s "$shipped" "$target"; then
    mv -f "$target" "$target.off"
  fi
}

# The parts of the shipped config the replace question offers, by the top
# folder a file sits in. Parts, not files: a3nuc2 alone had eleven files that
# differed, and with REAPER's presets a list of files runs past a screen.
config_group() {
  case "$1" in
    REAPER/*)     echo reaper ;;
    i3/*)         echo i3 ;;
    systemd/*)    echo systemd ;;
    rncbc.org/*)  echo qjackctl ;;
    IEM/*)        echo iem ;;
    *)            echo other ;;
  esac
}

config_group_label() {
  case "$1" in
    reaper)   echo "REAPER: template + OSC map + presets + effects" ;;
    i3)       echo "i3 config" ;;
    systemd)  echo "systemd user units" ;;
    qjackctl) echo "QjackCtl and patchbay" ;;
    iem)      echo "IEM plugin settings" ;;
    *)        echo "other files" ;;
  esac
}

# The parts with at least one file that is there and differs from the shipped
# one, in debconf's list form ("reaper, i3") and always in the same order. A
# file that is not there yet is not in it: installing it replaces nothing, so
# there is nothing to ask.
differing_config_groups() {
  src="$1"; dst="$2"
  found="$(find "$src" -type f | while IFS= read -r shipped; do
    rel="${shipped#"$src"/}"
    [ -e "$dst/$rel" ] || continue
    cmp -s "$shipped" "$dst/$rel" && continue
    config_group "$rel"
  done)"
  for g in reaper i3 systemd qjackctl iem other; do
    echo "$found" | grep -qx "$g" && echo "$g"
  done | paste -sd, - | sed 's/,/, /g'
}

# Whether $1 is in the debconf list $2 ("reaper, i3").
in_list() {
  case ", $2," in
    *", $1,"*) return 0 ;;
  esac
  return 1
}

# Put the shipped config in place, file by file. It used to be `cp -rn`, which
# never replaced anything: a Core set up from a home with an older a3 in it
# kept the old REAPER template, OSC map, i3 config and user units, and a new
# package changed nothing (a3nuc2, 2026-10-04). A file that is missing is
# installed. One that differs is replaced only if its part is in $replace --
# the answer to a3-core/replace-config -- and is copied to $backup first,
# keeping its path, and named: a local edit is replaced but neither lost nor
# silent. One whose part was not chosen stays, and is named too.
install_shipped_config() {
  src="$1"; dst="$2"; backup="$3"; replace="$4"
  find "$src" -type f | while IFS= read -r shipped; do
    rel="${shipped#"$src"/}"
    target="$dst/$rel"
    cmp -s "$shipped" "$target" && continue
    if [ -e "$target" ]; then
      if ! in_list "$(config_group "$rel")" "$replace"; then
        echo "a3-core: kept the local ~/.config/$rel"
        continue
      fi
      mkdir -p "$(dirname "$backup/$rel")"
      cp -p "$target" "$backup/$rel"
      echo "a3-core: replaced ~/.config/$rel (previous in $backup)"
    fi
    mkdir -p "$(dirname "$target")"
    cp "$shipped" "$target"
  done
}

# Ask which differing parts to replace. Every one is offered ticked: the old
# answer, replacing nothing, is what left a3nuc2 on a six-month-old REAPER,
# and nothing replaced is lost (decided 2026-10-04). Asked only when something
# differs, at high, and its choices are this machine's. An unattended install
# takes the ticked default: everything. The answer is left in REPLACE_CONFIG.
# Labels carry no commas: debconf reads a comma as the next choice.
#
# The a3-system installer asks this itself, before the package is installed,
# and hands the answer over preseeded and marked seen. Such an answer is taken
# as it is, not asked again and not overwritten with the default; seen is
# then cleared, so a later install without the installer asks once more.
ask_replace_question() {
  groups="$1"
  db_fget a3-core/replace-config seen || true
  if [ "x$RET" = "xtrue" ]; then
    db_get a3-core/replace-config
    REPLACE_CONFIG="$RET"
    db_fset a3-core/replace-config seen false || true
    return 0
  fi
  labels=""
  for g in $(echo "$groups" | tr -d ','); do
    labels="${labels:+$labels, }$(config_group_label "$g")"
  done
  db_subst a3-core/replace-config choices_c "$groups" || true
  db_subst a3-core/replace-config choices "$labels" || true
  db_set a3-core/replace-config "$groups" || true
  db_input high a3-core/replace-config || true
  db_go || true
  db_get a3-core/replace-config
  REPLACE_CONFIG="$RET"
  # Shown, debconf marks it seen; cleared, so it does not pass for the
  # installer's answer next time.
  db_fset a3-core/replace-config seen false || true
}

# Ask for the address, gateway and DNS on every install and upgrade, pre-filled
# with what is stored -- Enter keeps it. They ran at `medium`, which Debian does
# not show by default, and an answered question is never asked again: the
# answer from before the rig moved subnet went out silently with every install
# (2026-09-25). An unattended install still takes the stored value.
# The rig moved from 192.168.43.x to 192.168.8.x (see a3-doc's ports page).
# debconf pre-fills a question with the stored answer, not the template's
# default, so a machine set up on the old network was offered the old address
# first -- and a hurried Enter put it back (2026-09-25). An answer still on the
# retired network is reset to the template's default before it is shown. Each
# of the three on its own, and only an exact 192.168.43. prefix.
forget_retired_network() {
  for question in address gateway dns; do
    db_get "a3-core/$question" || true
    case "$RET" in
      192.168.43.*) db_reset "a3-core/$question" || true ;;
    esac
  done
}

ask_address_questions() {
  forget_retired_network
  for question in address gateway dns; do
    db_fset "a3-core/$question" seen false || true
    db_input high "a3-core/$question" || true
  done
  db_input medium a3-core/interface || true
  db_go || return 1
}

# The other wired socket on this machine, to offer as the bridge's second
# port: physical, not Wi-Fi, not the one already configured. Empty if there is
# none. A bridge onto lo or onto br0 itself would cut the box off.
other_wired_interface() {
  primary="$1"
  sysnet="${2:-/sys/class/net}"
  for path in "$sysnet"/*; do
    name=$(basename "$path")
    [ "$name" = "$primary" ] && continue
    [ -e "$path/device" ] || continue
    [ -e "$path/wireless" ] && continue
    [ -e "$path/phy80211" ] && continue
    echo "$name"
    return 0
  done
}

# Write the network for systemd-networkd into $dir: one socket in a3.network,
# or -- with a second socket -- the bridge prepared on 2026-09-09. The router
# has one free port, so the mixer hangs on the Core's second socket and the
# bridge makes both one segment. STP is on: once a switch is added, two cables
# into it are a loop, and a loop on a show network is a broadcast storm; the
# price is about thirty seconds after boot. Each variant removes the other's
# files, so answering "no bridge" is also the way back. Nothing is switched
# here: networkd reads the files at the next boot.
write_network_config() {
  dir="$1"; iface="$2"; with="$3"; addr="$4"; gateway="$5"; dns="$6"
  mkdir -p "$dir"

  # Only a unit whose content changes is written, and the one it replaces --
  # or removes -- is kept beside it as <name>.bak-<time>, a name networkd does
  # not read: a wrong write can be undone (a3-core#68).
  stamp="$(date +%Y%m%d-%H%M%S)"
  put_unit () {
    tmp="$(mktemp "$1.XXXXXX")"
    printf '%s\n' "$2" > "$tmp"
    if cmp -s "$tmp" "$1"; then
      rm -f "$tmp"
      return 0
    fi
    if [ -e "$1" ]; then
      cp -p "$1" "$1.bak-$stamp"
    fi
    chmod 644 "$tmp"
    chown root:root "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$1"
  }
  retire_unit () {
    [ -e "$1" ] || return 0
    mv -f "$1" "$1.bak-$stamp"
  }

  if [ -n "$with" ]; then
    put_unit "$dir/10-a3-bridge.netdev" "[NetDev]
Name=br0
Kind=bridge

[Bridge]
STP=yes"
    put_unit "$dir/20-a3-bridge-ports.network" "[Match]
Name=${iface} ${with}

[Network]
Bridge=br0"
    put_unit "$dir/30-a3-bridge-address.network" "[Match]
Name=br0

[Network]
Address=${addr}
Gateway=${gateway}
DNS=${dns}
ConfigureWithoutCarrier=yes"
    retire_unit "$dir/a3.network"
  else
    put_unit "$dir/a3.network" "[Match]
Name=${iface}

[Network]
Address=${addr}
Gateway=${gateway}
DNS=${dns}"
    retire_unit "$dir/10-a3-bridge.netdev"
    retire_unit "$dir/20-a3-bridge-ports.network"
    retire_unit "$dir/30-a3-bridge-address.network"
  fi
}

# Which socket to bridge with the configured one; empty is no bridge. Asked on
# every install like the address. Pre-filled with the other wired socket only
# the first time it is ever asked -- after that the stored answer stands, an
# empty one included, so a Core set to "no bridge" is not talked back into one.
ask_bridge_question() {
  db_fget a3-core/bridge-with seen || true
  if [ "x$RET" != "xtrue" ]; then
    db_set a3-core/bridge-with "$(other_wired_interface "$1")" || true
  fi
  db_fset a3-core/bridge-with seen false || true
  db_input high a3-core/bridge-with || true
  db_go || return 1
}

# Whether the a3-system installer answered the network questions. It preseeds
# its answers together with a3-core/preseeded=true; the marker is cleared here
# whatever it says, so it counts for this one install only. The `seen` flag is
# no such sign: package 1.0.0 showed configure-network itself, and the seen
# flag it left behind passed for the installer's answer -- an upgrade then
# rewrote the network unasked (a3-core#68).
installer_answered_network() {
  db_get a3-core/preseeded || true
  answered="$RET"
  db_set a3-core/preseeded false || true
  [ "x$answered" = "xtrue" ]
}

# Ask whether to configure network. High: at medium a fresh machine never saw
# it, took the default (no) and got no network at all. Asked every time, with
# no as the answer offered: debconf would offer the stored answer and skip a
# seen question, and one "yes" walked every later install through the whole
# network setup again (2026-10-01). Enter leaves the network as it is.
# Fails on ESC.
ask_configure_network() {
  db_reset a3-core/configure-network || true
  db_fset a3-core/configure-network seen false || true
  db_input high a3-core/configure-network || true
  db_go || return 1
}

# The steps below need root or the user's real home; they are functions of
# their own so the tests can stand in for them.
#
# The maintainer's network (hosts, Core's interface): created once from the
# package's defaults, never overwritten -- it is his to edit (spec
# truth-from-core).
create_network_file() {
  sudo -u "$APPUSER" -H "${USER_HOME}/.local/bin/a3-osc-render" network-file \
    || echo "a3-core: could not create ~/.config/a3/network.json" >&2
}

# INTERFACE, ADDR, GATEWAY, DNS and BRIDGE_WITH as shell assignments, from the
# truth joined with the user's ~/.config/a3/network.json (not root's: this
# runs as root).
render_default_network() {
  A3_NETWORK="${USER_HOME}/.config/a3/network.json" "${USER_HOME}/.local/bin/a3-osc-render" network
}

# Enable systemd-networkd but do NOT start it: the files take effect at boot.
enable_networkd() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable systemd-networkd.service || true
  fi
}

network_left() {
  echo "a3-core: network setup left (ESC), the network is as it was"
}

# The network step: the installer's marked answers, or asked here. ESC in any
# of its dialogs leaves it without writing anything -- no unit, no ifupdown
# edit, no network.json -- and the rest of the postinst carries on.
# network.json is created only for the default network, which is what it
# describes: asked answers are not in it, and a network left alone gets none
# (it used to be created on every install, naming eno1, a bridge with enp5s0
# and .10 on machines that had none of them).
network_step() {
  netdir="$1"; interfaces="$2"
  if installer_answered_network; then
    preseeded=true
  else
    preseeded=false
    if ! ask_configure_network; then
      network_left
      return 0
    fi
  fi
  db_get a3-core/configure-network
  configure="$RET"
  db_fset a3-core/configure-network seen false || true
  [ "x$configure" = "xtrue" ] || return 0

  db_get a3-core/install-default-network
  if [ "x$RET" = "xtrue" ]; then
    create_network_file
    eval "$(render_default_network)"
  else
    if [ "$preseeded" = false ] && ! ask_address_questions; then
      network_left
      return 0
    fi
    db_get a3-core/interface; INTERFACE="$RET"
    db_get a3-core/address; ADDR="$RET"
    db_get a3-core/gateway; GATEWAY="$RET"
    db_get a3-core/dns; DNS="$RET"

    if [ "$preseeded" = false ] && ! ask_bridge_question "$INTERFACE"; then
      network_left
      return 0
    fi
    db_get a3-core/bridge-with; BRIDGE_WITH="$RET"
  fi

  write_network_config "$netdir" "$INTERFACE" "$BRIDGE_WITH" \
    "$ADDR" "$GATEWAY" "$DNS"

  disable_ifupdown_for "$INTERFACE" "$interfaces"
  if [ -n "$BRIDGE_WITH" ]; then
    disable_ifupdown_for "$BRIDGE_WITH" "$interfaces"
  fi
  enable_networkd
}

network_step /etc/systemd/network /etc/network/interfaces

# Ask whether this Core runs without a monitor. High, not medium: Debian shows
# high and above by default, and the wrong default here is a black screen.
db_input high a3-core/headless-display || true
db_go || true
db_get a3-core/headless-display
apply_headless_choice "$RET" \
  "${USER_HOME}/.local/share/a3-core/x11/10-headless.conf" \
  /etc/X11/xorg.conf.d/10-headless.conf

# Continue with original postinst tasks (venv, pip, chown, enable services, etc.)
# --- existing operations start ---
# (preserve previous behavior; adjust below if your original postinst differs)
python3 -m venv "${USER_HOME}/.venv" || true
"${USER_HOME}/.venv/bin/pip" install -r "${USER_HOME}/.local/share/a3-core/recipes/requirements.txt" || true

mkdir -p /home/aaa/.config
SHIPPED_CONFIG="${USER_HOME}/.local/share/a3-core/config"
user_systemctl() {
  sudo -u "$APPUSER" env XDG_RUNTIME_DIR="/run/user/$UID" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID/bus" systemctl --user "$@"
}

REPLACE_CONFIG=""
DIFFERING="$(differing_config_groups "$SHIPPED_CONFIG" "${USER_HOME}/.config")"
if [ -n "$DIFFERING" ]; then
  ask_replace_question "$DIFFERING"
fi

# The postinst restarts nothing of the rig. A running REAPER keeps the old
# template in memory until it is restarted, and its stop no longer saves
# (a3-system#74), so the new file is not undone. The maintainer restarts
# a3-main himself after an upgrade.
install_shipped_config "$SHIPPED_CONFIG" "${USER_HOME}/.config" \
  "${USER_HOME}/.config/a3-replaced/$(date +%Y-%m-%d_%H%M%S)" "$REPLACE_CONFIG"
echo "a3-core: nothing restarted; restart a3-main to run the new config"

chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.local" || true
chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.config" || true
chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.ssh" || true

# zita's arguments and the beat-analyzer's targets, from a3-osc.json. A failure
# is said out loud: the zita units would start without their addresses.
sudo -u "$APPUSER" -H "${USER_HOME}/.local/bin/a3-osc-render" user \
  || echo "a3-core: a3-osc-render user failed -- zita and the analyzer lack their addresses" >&2

find "$USER_HOME/.config" -type d -exec chmod 0755 {} \;
find "$USER_HOME/.config" -type f -exec chmod 0664 {} \;

if [ -d /home/aaa/.ssh ]; then
  chmod 0700 /home/aaa/.ssh
  find /home/aaa/.ssh -type f -exec chmod 0600 {} \;
fi

echo "enable system services..."
systemctl daemon-reload || true
systemctl enable x11vnc.service || true
# Start it now too: enabling alone left VNC off until the next reboot (2026-10-06).
systemctl restart x11vnc.service || true
systemctl enable set_irq_prio.service || true

echo "enable userservices..."
# allow user services to run without an interactive session
loginctl enable-linger "${APPUSER}" || true

UID=$(id -u "$APPUSER")
XDG_RUNTIME_DIR="/run/user/$UID"
DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"

if sudo -u "$APPUSER" env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" systemctl --user daemon-reload; then
   # sudo -u "$APPUSER" env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" systemctl --user enable a3-main.service || true
    sudo -u "$APPUSER" env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" systemctl --user start a3-user-install.service || true
else
    echo "Failed to reload user daemon for $APPUSER"
fi

loginctl disable-linger "${APPUSER}" || true

echo "update grub..."
update-grub || true

echo "Installation complete."
echo "use 'systemctl --user status a3-user-install.service' to check status"
echo "use 'dpkg-reconfigure a3-core' to configure network and the headless screen"
echo "use 'dpkg-reconfigure jackd2' to enable rt-priority"
echo "Please Reboot or manage a3-core manually with 'systemctl --user start a3-main.service'"
