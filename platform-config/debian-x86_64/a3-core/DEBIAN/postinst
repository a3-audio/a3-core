#!/bin/sh
set -e

# Debconf helper
if [ -f /usr/share/debconf/confmodule ]; then
  . /usr/share/debconf/confmodule
fi

APPUSER="aaa"
UID=$(id -u $APPUSER)
USER_HOME=$(getent passwd "$APPUSER" | cut -d: -f6 || echo "/home/$APPUSER")

# Take an interface out of ifupdown's hands, so systemd-networkd is the only
# thing that configures it. With both, /etc/network/interfaces' DHCP stanza and
# a3.network's static address claimed the same interface, and the address the
# machine came up with depended on which one was first (a3-core issue #54).
# Comments the lines out rather than deleting them, so the change can be read
# and undone. Idempotent: a commented line no longer matches.
disable_ifupdown_for() {
  iface="$1"
  file="$2"
  [ -f "$file" ] || return 0
  sed -i \
    -e "s/^\([[:space:]]*\(allow-hotplug\|auto\)[[:space:]]\+${iface}[[:space:]]*\)$/# a3-core: networkd owns ${iface} -- \1/" \
    -e "s/^\([[:space:]]*iface[[:space:]]\+${iface}[[:space:]].*\)$/# a3-core: networkd owns ${iface} -- \1/" \
    "$file"
}

# Put X on the dummy screen, or take it off again. The config used to ship as
# an active conffile, which on a machine with a screen is a black monitor with
# everything running behind it -- and dpkg re-installs a conffile that is new
# to the package even where somebody had moved it aside (a3-core issue #53).
# "No" takes the shipped config out of X by renaming it, which mends a machine
# the old package left it on; a config somebody wrote themselves is left alone.
apply_headless_choice() {
  choice="$1"
  shipped="$2"
  target="$3"
  if [ "x$choice" = "xtrue" ]; then
    mkdir -p "$(dirname "$target")"
    cp "$shipped" "$target"
    return 0
  fi
  if [ -f "$target" ] && cmp -s "$shipped" "$target"; then
    mv -f "$target" "$target.off"
  fi
}

# Ask for the address, gateway and DNS on every install and upgrade, pre-filled
# with what is stored -- Enter keeps it. They ran at `medium`, which Debian does
# not show by default, and an answered question is never asked again: the
# answer from before the rig moved subnet went out silently with every install
# (2026-09-25). An unattended install still takes the stored value.
# The rig moved from 192.168.43.x to 192.168.8.x (see a3-doc's ports page).
# debconf pre-fills a question with the stored answer, not the template's
# default, so a machine set up on the old network was offered the old address
# first -- and a hurried Enter put it back (2026-09-25). An answer still on the
# retired network is reset to the template's default before it is shown. Each
# of the three on its own, and only an exact 192.168.43. prefix.
forget_retired_network() {
  for question in address gateway dns; do
    db_get "a3-core/$question" || true
    case "$RET" in
      192.168.43.*) db_reset "a3-core/$question" || true ;;
    esac
  done
}

ask_address_questions() {
  forget_retired_network
  for question in address gateway dns; do
    db_fset "a3-core/$question" seen false || true
    db_input high "a3-core/$question" || true
  done
  db_input medium a3-core/interface || true
  db_go || true
}

# The other wired socket on this machine, to offer as the bridge's second
# port: physical, not Wi-Fi, not the one already configured. Empty if there is
# none. A bridge onto lo or onto br0 itself would cut the box off.
other_wired_interface() {
  primary="$1"
  sysnet="${2:-/sys/class/net}"
  for path in "$sysnet"/*; do
    name=$(basename "$path")
    [ "$name" = "$primary" ] && continue
    [ -e "$path/device" ] || continue
    [ -e "$path/wireless" ] && continue
    [ -e "$path/phy80211" ] && continue
    echo "$name"
    return 0
  done
}

# Write the network for systemd-networkd into $dir: one socket in a3.network,
# or -- with a second socket -- the bridge prepared on 2026-09-09. The router
# has one free port, so the mixer hangs on the Core's second socket and the
# bridge makes both one segment. STP is on: once a switch is added, two cables
# into it are a loop, and a loop on a show network is a broadcast storm; the
# price is about thirty seconds after boot. Each variant removes the other's
# files, so answering "no bridge" is also the way back. Nothing is switched
# here: networkd reads the files at the next boot.
write_network_config() {
  dir="$1"; iface="$2"; with="$3"; addr="$4"; gateway="$5"; dns="$6"
  mkdir -p "$dir"

  put_unit () {
    tmp="$(mktemp "$1.XXXXXX")"
    printf '%s\n' "$2" > "$tmp"
    chmod 644 "$tmp"
    chown root:root "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$1"
  }

  if [ -n "$with" ]; then
    put_unit "$dir/10-a3-bridge.netdev" "[NetDev]
Name=br0
Kind=bridge

[Bridge]
STP=yes"
    put_unit "$dir/20-a3-bridge-ports.network" "[Match]
Name=${iface} ${with}

[Network]
Bridge=br0"
    put_unit "$dir/30-a3-bridge-address.network" "[Match]
Name=br0

[Network]
Address=${addr}
Gateway=${gateway}
DNS=${dns}
ConfigureWithoutCarrier=yes"
    rm -f "$dir/a3.network"
  else
    put_unit "$dir/a3.network" "[Match]
Name=${iface}

[Network]
Address=${addr}
Gateway=${gateway}
DNS=${dns}"
    rm -f "$dir/10-a3-bridge.netdev" "$dir/20-a3-bridge-ports.network" \
          "$dir/30-a3-bridge-address.network"
  fi
}

# Which socket to bridge with the configured one; empty is no bridge. Asked on
# every install like the address. Pre-filled with the other wired socket only
# the first time it is ever asked -- after that the stored answer stands, an
# empty one included, so a Core set to "no bridge" is not talked back into one.
ask_bridge_question() {
  db_fget a3-core/bridge-with seen || true
  if [ "x$RET" != "xtrue" ]; then
    db_set a3-core/bridge-with "$(other_wired_interface "$1")" || true
  fi
  db_fset a3-core/bridge-with seen false || true
  db_input high a3-core/bridge-with || true
  db_go || true
}

# Ask whether to configure network. High: at medium a fresh machine never saw
# it, took the default (no) and got no network at all.
db_input high a3-core/configure-network || true
db_go || true
db_get a3-core/configure-network
CONFIGURE="$RET"

if [ "x$CONFIGURE" = "xtrue" ]; then
  # Check if user wants the standard/default network
  db_get a3-core/install-default-network
  INSTALL_DEFAULT="$RET"

  if [ "x$INSTALL_DEFAULT" = "xtrue" ]; then
    INTERFACE="eno1"
    ADDR="192.168.8.10/24"
    GATEWAY="192.168.8.1"
    DNS="192.168.8.1"
  else
    ask_address_questions

    db_get a3-core/interface; INTERFACE="$RET"
    db_get a3-core/address; ADDR="$RET"
    db_get a3-core/gateway; GATEWAY="$RET"
    db_get a3-core/dns; DNS="$RET"

    ask_bridge_question "$INTERFACE"
  fi

  db_get a3-core/bridge-with; BRIDGE_WITH="$RET"

  write_network_config /etc/systemd/network "$INTERFACE" "$BRIDGE_WITH" \
    "$ADDR" "$GATEWAY" "$DNS"

  disable_ifupdown_for "$INTERFACE" /etc/network/interfaces
  if [ -n "$BRIDGE_WITH" ]; then
    disable_ifupdown_for "$BRIDGE_WITH" /etc/network/interfaces
  fi

  # Enable systemd-networkd unit but do NOT start it
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable systemd-networkd.service || true
  fi
fi

# Ask whether this Core runs without a monitor. High, not medium: Debian shows
# high and above by default, and the wrong default here is a black screen.
db_input high a3-core/headless-display || true
db_go || true
db_get a3-core/headless-display
apply_headless_choice "$RET" \
  "${USER_HOME}/.local/share/a3-core/x11/10-headless.conf" \
  /etc/X11/xorg.conf.d/10-headless.conf

# Continue with original postinst tasks (venv, pip, chown, enable services, etc.)
# --- existing operations start ---
# (preserve previous behavior; adjust below if your original postinst differs)
python3 -m venv "${USER_HOME}/.venv" || true
"${USER_HOME}/.venv/bin/pip" install -r "${USER_HOME}/.local/share/a3-core/recipes/requirements.txt" || true

mkdir -p /home/aaa/.config
cp -rn /home/aaa/.local/share/a3-core/config/* /home/aaa/.config/

chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.local" || true
chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.config" || true
chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.ssh" || true

find "$USER_HOME/.config" -type d -exec chmod 0755 {} \;
find "$USER_HOME/.config" -type f -exec chmod 0664 {} \;

if [ -d /home/aaa/.ssh ]; then
  chmod 0700 /home/aaa/.ssh
  find /home/aaa/.ssh -type f -exec chmod 0600 {} \;
fi

echo "enable system services..."
systemctl daemon-reload || true
systemctl enable x11vnc.service || true
systemctl enable set_irq_prio.service || true

echo "enable userservices..."
# allow user services to run without an interactive session
loginctl enable-linger "${APPUSER}" || true

UID=$(id -u "$APPUSER")
XDG_RUNTIME_DIR="/run/user/$UID"
DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"

if sudo -u "$APPUSER" env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" systemctl --user daemon-reload; then
   # sudo -u "$APPUSER" env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" systemctl --user enable a3-main.service || true
    sudo -u "$APPUSER" env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" systemctl --user start a3-user-install.service || true
else
    echo "Failed to reload user daemon for $APPUSER"
fi

loginctl disable-linger "${APPUSER}" || true

echo "update grub..."
update-grub || true

echo "Installation complete."
echo "use 'systemctl --user status a3-user-install.service' to check status"
echo "use 'dpkg-reconfigure a3-core' to configure network and the headless screen"
echo "use 'dpkg-reconfigure jackd2' to enable rt-priority"
echo "Please Reboot or manage a3-core manually with 'systemctl --user start a3-main.service'"
