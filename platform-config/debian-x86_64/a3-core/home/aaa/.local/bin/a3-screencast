#!/usr/bin/env bash
# The picture of this machine's screen as an MPEG-TS stream that OBS connects to.
# ffmpeg is the listener and ends when the viewer leaves; the a3-screencast
# user unit starts it again. No sound: OBS takes it from AES67.
#
# Settings (~/.config/a3/screencast.env, optional, read by the unit):
#   A3_SCREENCAST_CPUS  cores for the encoder, default 0 (the audio units have 1-3)
#   A3_SCREENCAST_FPS   default 30
#   A3_SCREENCAST_CRF   quality, lower is better, default 23
# The port is A3_SCREENCAST_PORT from osc.env, rendered from a3-osc.json.
set -euo pipefail

: "${A3_SCREENCAST_PORT:?not set -- run a3-osc-render}"
CPUS="${A3_SCREENCAST_CPUS:-0}"
FPS="${A3_SCREENCAST_FPS:-30}"
CRF="${A3_SCREENCAST_CRF:-23}"
export DISPLAY="${DISPLAY:-:0}"

SIZE="$(xdpyinfo | awk '/dimensions:/ { print $2 }')"

# The machine plays live: niced, on the core the audio units leave free. Not
# SCHED_IDLE: on 2026-10-17 it left the encoder waiting longer than it ran.
# On the CPU, never VAAPI: an encoder hung in a GPU reset on the rig's amdgpu
# (2026-09-29), taking every screen reader after it down.
# Latency: a short grab queue (a late grab is a fresh frame, not a queued one),
# no muxer delay (the default held PCR 0.73 s behind the picture), every packet
# written at once.
exec nice -n 19 taskset -c "$CPUS" ffmpeg -hide_banner -loglevel warning -nostdin \
    -fflags nobuffer -thread_queue_size 4 \
    -f x11grab -framerate "$FPS" -video_size "$SIZE" -draw_mouse 0 -i "$DISPLAY" \
    -an -fps_mode vfr \
    -c:v libx264 -preset veryfast -tune zerolatency -crf "$CRF" -pix_fmt yuv420p -g $(( FPS * 2 )) \
    -muxdelay 0 -muxpreload 0 -flush_packets 1 \
    -f mpegts "tcp://0.0.0.0:${A3_SCREENCAST_PORT}?listen=1"
