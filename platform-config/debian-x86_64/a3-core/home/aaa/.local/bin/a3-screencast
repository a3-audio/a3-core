#!/usr/bin/env bash
# Screen and sound of this machine as an MPEG-TS stream that OBS connects to.
# ffmpeg is the listener and ends when the viewer leaves; the a3-screencast
# user unit starts it again.
#
# Sound: ffmpeg registers a JACK client "screencast" (input_1, input_2). It is
# never connected from here -- the patchbay is not ours to change; connect it
# by hand, unconnected it is silent.
#
# Settings (~/.config/a3/screencast.env, optional, read by the unit):
#   A3_SCREENCAST_CPUS  cores for the encoder, default: the highest one
#   A3_SCREENCAST_FPS   default 30
#   A3_SCREENCAST_CRF   quality, lower is better, default 23
# The port is A3_SCREENCAST_PORT from osc.env, rendered from a3-osc.json.
set -euo pipefail

: "${A3_SCREENCAST_PORT:?not set -- run a3-osc-render}"
CPUS="${A3_SCREENCAST_CPUS:-$(( $(nproc) - 1 ))}"
FPS="${A3_SCREENCAST_FPS:-30}"
CRF="${A3_SCREENCAST_CRF:-23}"
export DISPLAY="${DISPLAY:-:0}"

SIZE="$(xdpyinfo | awk '/dimensions:/ { print $2 }')"

# The machine plays live: the encoder only gets time nothing else wants.
# On the CPU, never VAAPI: an encoder hung in a GPU reset on the rig's amdgpu
# (2026-09-29), taking every screen reader after it down.
exec nice -n 19 chrt --idle 0 taskset -c "$CPUS" ffmpeg -hide_banner -loglevel warning -nostdin \
    -thread_queue_size 1024 -f x11grab -framerate "$FPS" -video_size "$SIZE" -draw_mouse 0 -i "$DISPLAY" \
    -thread_queue_size 1024 -f jack -channels 2 -i screencast \
    -c:v libx264 -preset veryfast -tune zerolatency -crf "$CRF" -pix_fmt yuv420p -g $(( FPS * 2 )) \
    -c:a aac -b:a 256k \
    -f mpegts "tcp://0.0.0.0:${A3_SCREENCAST_PORT}?listen=1"
