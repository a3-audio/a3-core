#
# Internal helper for the units' ExecCondition: does the a3-engine run, or
# does REAPER?
#
#   a3-engine-runs           exit 0: the engine runs
#   a3-engine-runs --reaper  exit 1: REAPER does not
#
# Since the cut there is no fallback: the a3-core program is the Core and the
# engine always runs. REAPER's files stay as they were, frozen; its drop-in
# (and StemDeck's) still ask here, and the answer keeps REAPER off.

case "$#:${1-}" in
  0:) exit 0 ;;
  1:--reaper) exit 1 ;;
esac
echo "usage: a3-engine-runs [--reaper]" >&2
exit 2
