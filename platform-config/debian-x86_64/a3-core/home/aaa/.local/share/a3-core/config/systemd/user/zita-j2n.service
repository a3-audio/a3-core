[Unit]               
Description=zita-j2n
PartOf=a3-main.service
After=a3-jack.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/bin/zita-j2n --chan 2 --24bit 192.168.43.96 55100
CPUAffinity=1 2 3
CPUSchedulingPolicy=rr
CPUSchedulingPriority=64
# Faellt zita aus (Status 0 trotzdem), kommt es nach 2 s wieder, ohne Obergrenze.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
