[Unit]                                                                                     
Description=a3-main
After=graphical.target
# Wants, not Requires.
#
# Requires means: if one of these is deactivated, so is this one. Together
# with the PartOf= each of them carries -- "when the mother stops, stop too"
# -- that was a trap in both directions. Stopping one component stopped the
# mother, and the mother stopping took the other four with it, so a single
# `systemctl --user stop a3-core` took down jack, REAPER, qjackctl and the
# beat-analyzer. There was no way to restart one thing, which is the first
# thing anybody wants to do while working on one thing.
#
# Wants starts them all the same way and lets each be stopped, restarted or
# fail on its own. PartOf still gives the group its meaning: stop or restart
# a3-main and everything follows.
Wants=a3-jack.service qjackctl.service a3-reaper.service a3-core.service beat-analyzer.service a3-motion.service
# a3-motion is listed even though this package does not ship its unit:
# Wants= on something absent is not an error, and on a machine that has
# it the group is then whole. On a rig where Motion sits on its own
# Raspberry Pi -- which is what it is designed to be -- the name simply
# matches nothing here.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# Nothing here: PartOf= on each component already means "when a3-main stops,
# stop too". Saying it twice is a second thing to keep in step with the list
# above, and it was already one name out of date once.
ExecStop=/bin/true

[Install]
WantedBy=default.target
