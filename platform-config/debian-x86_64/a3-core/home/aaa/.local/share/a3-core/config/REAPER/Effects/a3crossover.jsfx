desc:Band Splitter 2->4 (Freq + BW + Slope)

// Slider
slider1:400<400,2500>Frequenz (Hz)
slider2:5000<500,5000>Bandbreite (Hz)
slider3:4<1,4,1>Flankensteilheit (1?4 Stages)
slider4:0<-40,24>Rest Gain (dB)

@init
pi = 3.14159265358979;

// Bandpass Filterzustände für 4 Stages
bp_x1L = bp_x2L = bp_y1L = bp_y2L = 0;
bp_x1R = bp_x2R = bp_y1R = bp_y2R = 0;

bp2_x1L = bp2_x2L = bp2_y1L = bp2_y2L = 0;
bp2_x1R = bp2_x2R = bp2_y1R = bp2_y2R = 0;

bp3_x1L = bp3_x2L = bp3_y1L = bp3_y2L = 0;
bp3_x1R = bp3_x2R = bp3_y1R = bp3_y2R = 0;

bp4_x1L = bp4_x2L = bp4_y1L = bp4_y2L = 0;
bp4_x1R = bp4_x2R = bp4_y1R = bp4_y2R = 0;

@slider
freq = slider1;
bw   = slider2;
stages = slider3|0;
rest_gain = 10^(slider4/20); // dB ? linear

// Q aus Bandbreite
Q = freq / bw;

// Biquad Bandpass Koeffizienten
omega = 2*pi*freq/srate;
sn = sin(omega);
cs = cos(omega);
alpha = sn/(2*Q);

b0 =  alpha;
b1 =  0;
b2 = -alpha;
a0 =  1 + alpha;
a1 = -2*cs;
a2 =  1 - alpha;

bp_b0 = b0/a0;
bp_b1 = b1/a0;
bp_b2 = b2/a0;
bp_a1 = a1/a0;
bp_a2 = a2/a0;

@sample
inL = spl0;
inR = spl1;

// Stage 1
yL = bp_b0*inL + bp_b1*bp_x1L + bp_b2*bp_x2L - bp_a1*bp_y1L - bp_a2*bp_y2L;
bp_x2L = bp_x1L;
bp_x1L = inL;
bp_y2L = bp_y1L;
bp_y1L = yL;
bpL = yL;

yR = bp_b0*inR + bp_b1*bp_x1R + bp_b2*bp_x2R - bp_a1*bp_y1R - bp_a2*bp_y2R;
bp_x2R = bp_x1R;
bp_x1R = inR;
bp_y2R = bp_y1R;
bp_y1R = yR;
bpR = yR;

// Stage 2
stages > 1 ? (
  yL = bp_b0*bpL + bp_b1*bp2_x1L + bp_b2*bp2_x2L - bp_a1*bp2_y1L - bp_a2*bp2_y2L;
  bp2_x2L = bp2_x1L;
  bp2_x1L = bpL;
  bp2_y2L = bp2_y1L;
  bp2_y1L = yL;
  bpL = yL;

  yR = bp_b0*bpR + bp_b1*bp2_x1R + bp_b2*bp2_x2R - bp_a1*bp2_y1R - bp_a2*bp2_y2R;
  bp2_x2R = bp2_x1R;
  bp2_x1R = bpR;
  bp2_y2R = bp2_y1R;
  bp2_y1R = yR;
  bpR = yR;
);

// Stage 3
stages > 2 ? (
  yL = bp_b0*bpL + bp_b1*bp3_x1L + bp_b2*bp3_x2L - bp_a1*bp3_y1L - bp_a2*bp3_y2L;
  bp3_x2L = bp3_x1L;
  bp3_x1L = bpL;
  bp3_y2L = bp3_y1L;
  bp3_y1L = yL;
  bpL = yL;

  yR = bp_b0*bpR + bp_b1*bp3_x1R + bp_b2*bp3_x2R - bp_a1*bp3_y1R - bp_a2*bp3_y2R;
  bp3_x2R = bp3_x1R;
  bp3_x1R = bpR;
  bp3_y2R = bp3_y1R;
  bp3_y1R = yR;
  bpR = yR;
);

// Stage 4
stages > 3 ? (
  yL = bp_b0*bpL + bp_b1*bp4_x1L + bp_b2*bp4_x2L - bp_a1*bp4_y1L - bp_a2*bp4_y2L;
  bp4_x2L = bp4_x1L;
  bp4_x1L = bpL;
  bp4_y2L = bp4_y1L;
  bp4_y1L = yL;
  bpL = yL;

  yR = bp_b0*bpR + bp_b1*bp4_x1R + bp_b2*bp4_x2R - bp_a1*bp4_y1R - bp_a2*bp4_y2R;
  bp4_x2R = bp4_x1R;
  bp4_x1R = bpR;
  bp4_y2R = bp4_y1R;
  bp4_y1R = yR;
  bpR = yR;
);

// Band = Bandpass
bandL = bpL;
bandR = bpR;

// Rest = Original - Band, mit Gain
restL = (inL - bandL) * rest_gain;
restR = (inR - bandR) * rest_gain;

// Outputs
spl0 = bandL;
spl1 = bandR;
spl2 = restL;
spl3 = restR;

