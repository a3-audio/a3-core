[Unit]                                                                                     
Description=a3-core (python osc server)
PartOf=a3-main.service
# It talks to REAPER, which talks to jack. Starting before them is not fatal
# -- OSC goes into the void until they are up -- but it is an ordering that
# was never stated, and the only one of the five that had none.
After=a3-jack.service a3-reaper.service


[Service]
Type=idle
PrivateTmp=true
#ExecStartPre=/bin/sleep 3
ExecStart=/home/aaa/.venv/bin/python3 /home/aaa/.local/bin/a3-core.py
CPUAffinity=0

[Install]
WantedBy=default.target
