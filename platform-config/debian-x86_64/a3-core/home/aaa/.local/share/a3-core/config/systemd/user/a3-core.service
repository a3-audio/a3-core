[Unit]                                                                                     
Description=a3-core (python osc server)
PartOf=a3-main.service
# Before REAPER, and that is the whole point rather than a detail.
#
# Core does not hold the channel strip -- it relays what REAPER reports, and
# REAPER reports on change. It announces its state once, when it starts. If
# Core is not listening at that moment it never hears it, and from then on
# only learns a value when a hand moves it. A device asking /state/recall then
# gets an answer with no volume, no gain and no EQ in it, and comes up with
# its faders at whatever it booted with. See a3-motion-ui issue #17.
#
# jack still has to be up first: REAPER needs it, and Core reaching the void
# for a moment costs nothing -- the previous ordering said as much.
After=a3-jack.service
Before=a3-reaper.service


[Service]
Type=idle
PrivateTmp=true
#ExecStartPre=/bin/sleep 3
ExecStart=/home/aaa/.venv/bin/python3 /home/aaa/.local/bin/a3-core.py

[Install]
WantedBy=default.target
