[Unit]                                                                                     
Description=a3-jack
PartOf=a3-main.service
After=sound.target

[Service]
ExecStartPre=/usr/bin/sleep 1
ExecStart=/usr/bin/jackd -P 19 -v -aa -dalsa -dhw:USB -r44100 -p128 
ExecStop=/usr/bin/pkill -9 jackd
Type=simple
CPUAffinity=1 2 3
CPUSchedulingPolicy=rr
CPUSchedulingPriority=85

[Install]
WantedBy=default.target
