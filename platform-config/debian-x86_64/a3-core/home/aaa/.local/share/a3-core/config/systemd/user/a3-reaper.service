[Unit]                                                                                     
Description=a3-reaper
PartOf=a3-main.service
After=graphical.target pipewire.service wireplumber.service

[Service]
PrivateTmp=true
# The display by name and the screen awaited here: getty logs aaa in before
# X is up, so the user manager may start this unit before ~/.xinitrc has
# imported DISPLAY (2026-10-05, no display manager any more).
Environment=DISPLAY=:0
ExecStartPre=/home/aaa/.local/bin/a3-wait-for-the-screen
#WorkingDirectory=/home/aaa/.config/REAPER
# The JACK server accepting clients, not two seconds: After= says the audio
# server was started, which is not the same as ready. jack_wait blocks until
# it answers -- through pipewire-jack, PipeWire's JACK library.
ExecStartPre=/usr/bin/jack_wait -w
ExecStart=/bin/bash -c "/home/aaa/.local/opt/REAPER/reaper -nosplash -ignoreerrors -template /home/aaa/.config/REAPER/ProjectTemplates/a3-reaper.RPP"
# Closes without saving. It saved the project over the template until
# 2026-10-07; that wrote the outputs back open, which the silent start
# (a3-system#74) needs shut. Core replays every controlled value at start;
# anything set only in REAPER is saved by hand, on purpose.
ExecStop=/home/aaa/.local/opt/REAPER/reaper -closeall:nosave
# No CPUScheduling here: raising the whole process put its GUI/OSC threads
# above JACK's process threads (late clients on a3nuc1, 2026-10-06). The
# audio threads get their priority from the JACK library.
CPUAffinity=1 2 3

[Install]
WantedBy=default.target
