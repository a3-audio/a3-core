[Unit]                                                                                     
Description=beat-analyzer (bpm & vu-meters)
PartOf=a3-main.service
After=a3-jack.service

[Service]
Type=idle
#PrivateTmp=true
WorkingDirectory=/home/aaa/a3-system/beat-analyzer/build
ExecStartPre=/bin/sleep 3
ExecStart=/home/aaa/a3-system/beat-analyzer/build/beat-analyzer
# No CPUScheduling here: raising the whole process put all its threads, OSC
# and analysis included, above JACK's process threads (late clients on
# a3nuc1, 2026-10-06). The audio threads get their priority from JACK
# (server -P minus 5).
CPUAffinity=1 2 3

[Install]
WantedBy=default.target
