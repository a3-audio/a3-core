[Unit]
Description=i3bar on the tool workspaces (3 on), hidden on A3 Motion and StemDeck
After=graphical.target

[Service]
Environment=DISPLAY=:0
ExecStartPre=/home/aaa/.local/bin/a3-wait-for-the-screen
ExecStart=/usr/bin/python3 /home/aaa/.local/bin/a3-bar-per-workspace.py
# i3 restarting ends the event stream; follow it again.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
