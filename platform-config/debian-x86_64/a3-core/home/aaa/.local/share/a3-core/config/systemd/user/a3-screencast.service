[Unit]
Description=The picture of this machine's screen for OBS (MPEG-TS listener)
After=graphical.target
StartLimitIntervalSec=0

[Service]
Environment=DISPLAY=:0
# Port from a3-osc.json, rendered by a3-osc-render; the settings file is optional.
EnvironmentFile=%h/.config/a3/osc.env
EnvironmentFile=-%h/.config/a3/screencast.env
ExecStartPre=%h/.local/bin/a3-wait-for-the-screen
ExecStart=%h/.local/bin/a3-screencast
# ffmpeg ends when the viewer disconnects; listen again for the next one.
Restart=always
RestartSec=2

# Not linked into default.target.wants by the package: each machine opts in.
[Install]
WantedBy=default.target
