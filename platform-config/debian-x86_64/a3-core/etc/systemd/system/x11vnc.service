[Unit]
Description=x11vnc
After=graphical.target
# Never give up: X may come up late, and the screen must always be reachable.
StartLimitIntervalSec=0

[Service]
User=aaa
WorkingDirectory=/home/aaa
Environment=DISPLAY=:0
ExecStartPre=/usr/bin/sleep 5
# The port comes from a3-osc.json, rendered by a3-osc-render. %h would be
# root's home here, whatever User= says.
EnvironmentFile=/home/aaa/.config/a3/osc.env
ExecStart=/usr/bin/x11vnc -reopen -shared -forever -rfbport ${A3_VNC_PORT} -display :0 -ncache 0 -auth /home/aaa/.Xauthority
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
