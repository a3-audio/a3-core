[Unit]
Description=a3-engine, the A3 audio engine
PartOf=a3-main.service
After=pipewire.service wireplumber.service
# One engine on the PA: REAPER (a3-reaper.service) stays off while this one runs.
Conflicts=a3-reaper.service
# A failed open (JACK absent, a port taken) restarts five times in a minute and then stops,
# visibly, instead of looping while REAPER is off. There is no automatic fallback (REAPER is frozen).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# The engine runs when it is installed and `a3-engine --check-config` passes; otherwise this unit
# is skipped (exit 1 of the condition is not a failure) and a3-reaper.service runs as before.
# Environment= below applies to this command too: the preload is harmless to a Python helper.
ExecCondition=/home/aaa/.local/bin/a3-engine-runs
# The display by name and the screen awaited here, as a3-reaper.service does.
Environment=DISPLAY=:0
ExecStartPre=/home/aaa/.local/bin/a3-wait-for-the-screen
# The JACK server accepting clients, not merely started (pipewire-jack answers).
ExecStartPre=/usr/bin/jack_wait -w
ExecStart=/usr/bin/a3-engine --service
# No CPUScheduling here, as in a3-reaper.service: raising the whole process would put its
# GUI/OSC threads above JACK's process threads (2026-10-06). The audio threads get their priority
# from the JACK library; pipewire-jack's answer is uninitialised, so this preload gives the right
# one (a3-core's postinst builds it).
Environment=LD_PRELOAD=%h/.local/lib/a3/libjack-rt-priority.so
CPUAffinity=1 2 3
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
