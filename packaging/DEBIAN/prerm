#!/bin/sh
# a3-core-app ships the unit and stays when this package goes, so the links
# that this package's `systemctl --global enable` made are removed here. Not on
# upgrade: the new version keeps the unit enabled.
set -e

case "$1" in
	remove|deconfigure)
		if command -v systemctl >/dev/null 2>&1; then
			systemctl --global disable a3-engine.service || true
		fi
		;;
esac

exit 0
