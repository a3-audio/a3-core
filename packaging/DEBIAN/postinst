# A link in a .wants or .requires folder that pointed at the copy now aside
# points at the package's unit: what was enabled stays enabled. The rig's links
# name the copy by its whole path (/home/aaa/.config/systemd/user/<name>).
repoint_wants_links() {
  units_dir="$1"; name="$2"; package_dir="$3"
  for link in "$units_dir"/*.wants/"$name" "$units_dir"/*.requires/"$name"; do
    [ -L "$link" ] || continue
    case "$(readlink "$link")" in
      "$units_dir/$name"|*/.config/systemd/user/"$name"|"../$name"|"$name") ;;
      *) continue ;;
    esac
    ln -sfn "$package_dir/$name" "$link"
    chown -h --reference="$units_dir" "$link" 2>/dev/null || true
  done
}

# Every A3 user unit ships under /usr/lib/systemd/user since 2026-10-31: the
# program's from a3-core-app, the rig's (a3-main, a3-aes67, a3-screencast, the
# bar) and the drop-ins for StemDeck and the analyzer from this package.
# ~/.config/systemd/user keeps only the machine's own drop-ins. A copy this
# package once put there would hide the packaged unit, so it is moved aside
# to <name>.before-one-place -- systemd reads no such name -- never deleted,
# and its .wants links follow the packaged unit. Only a copy whose checksum is
# one of units_before_one_place: a file changed by hand stays and is named.
move_aside_unit_copies() {
  units_dir="$1"; package_dir="${2:-/usr/lib/systemd/user}"
  units_before_one_place | cut -d' ' -f3 | sort -u | while IFS= read -r rel; do
    copy="$units_dir/$rel"
    [ -f "$copy" ] && [ ! -L "$copy" ] || continue
    sum="$(sha256sum < "$copy" | cut -d' ' -f1)"
    if ! units_before_one_place | grep -qxF "$sum  $rel"; then
      echo "a3-core: kept the hand-changed ~/.config/systemd/user/$rel -- it comes before the package's units in $package_dir; move it aside to run the package's"
      continue
    fi
    if [ -e "$copy.before-one-place" ] || [ -L "$copy.before-one-place" ]; then
      echo "a3-core: kept ~/.config/systemd/user/$rel -- $rel.before-one-place is in the way" >&2
      continue
    fi
    if ! mv "$copy" "$copy.before-one-place"; then
      echo "a3-core: could not move ~/.config/systemd/user/$rel aside -- it still hides the package's" >&2
      continue
    fi
    echo "a3-core: moved ~/.config/systemd/user/$rel aside to $rel.before-one-place -- the package's in $package_dir runs"
    case "$rel" in
      */*) ;;
      *) repoint_wants_links "$units_dir" "$rel" "$package_dir" ;;
    esac
  done
}

# A drop-in that starts the old Core script (a3-core.py, gone since the cut to
# the program). a3nuc1 had one, override.conf; the deployment's program.conf
# sorted after it and started the program instead. With that copy aside the
# drop-in would start a file that is not there, so it goes to the backup,
# named, like the REAPER drop-ins.
retire_core_script_drop_ins() {
  config="$1"; backup="$2"
  for drop_in in "$config"/systemd/user/a3-core.service.d/*.conf; do
    [ -f "$drop_in" ] || continue
    grep -Eq '^ExecStart=.*a3-core\.py' "$drop_in" || continue
    rel="${drop_in#"$config"/}"
    if mkdir -p "$(dirname "$backup/$rel")" 2>/dev/null \
       && mv "$drop_in" "$backup/$rel"; then
      echo "a3-core: moved ~/.config/$rel (it started the old Core script, which is gone) to $backup"
    else
      echo "a3-core: could not move ~/.config/$rel -- the Core would not start" >&2
    fi
  done
}

# Stop what retire_jack_and_zita_units and retire_reaper_files took away and
# still runs.
stop_retired_units() {
  [ -n "$RETIRED_UNITS" ] || return 0
  user_systemctl stop $RETIRED_UNITS || true
}

# Ask which differing parts to replace. Every one is offered ticked: the old
# answer, replacing nothing, is what left a3nuc2 on a six-month-old REAPER template,
# and nothing replaced is lost (decided 2026-10-04). Asked only when something
# differs, at high, and its choices are this machine's. An unattended install
# takes the ticked default: everything. The answer is left in REPLACE_CONFIG.
# Labels carry no commas: debconf reads a comma as the next choice.
#
# The a3-system installer asks this itself, before the package is installed,
# and hands the answer over preseeded and marked seen. Such an answer is taken
# as it is, not asked again and not overwritten with the default; seen is
# then cleared, so a later install without the installer asks once more.
ask_replace_question() {
  groups="$1"
  db_fget a3-core/replace-config seen || true
  if [ "x$RET" = "xtrue" ]; then
    db_get a3-core/replace-config
    REPLACE_CONFIG="$RET"
    db_fset a3-core/replace-config seen false || true
    return 0
  fi
  labels=""
  for g in $(echo "$groups" | tr -d ','); do
    labels="${labels:+$labels, }$(config_group_label "$g")"
  done
  db_subst a3-core/replace-config choices_c "$groups" || true
  db_subst a3-core/replace-config choices "$labels" || true
  db_set a3-core/replace-config "$groups" || true
  db_input high a3-core/replace-config || true
  db_go || true
  db_get a3-core/replace-config
  REPLACE_CONFIG="$RET"
  # Shown, debconf marks it seen; cleared, so it does not pass for the
  # installer's answer next time.
  db_fset a3-core/replace-config seen false || true
}

# Ask for the address, gateway and DNS on every install and upgrade, pre-filled
# with what is stored -- Enter keeps it. They ran at `medium`, which Debian does
# not show by default, and an answered question is never asked again: the
# answer from before the rig moved subnet went out silently with every install
# (2026-09-25). An unattended install still takes the stored value.
# The rig moved from 192.168.43.x to 192.168.8.x (see a3-doc's ports page).
# debconf pre-fills a question with the stored answer, not the template's
# default, so a machine set up on the old network was offered the old address
# first -- and a hurried Enter put it back (2026-09-25). An answer still on the
# retired network is reset to the template's default before it is shown. Each
# of the three on its own, and only an exact 192.168.43. prefix.
forget_retired_network() {
  for question in address gateway dns; do
    db_get "a3-core/$question" || true
    case "$RET" in
      192.168.43.*) db_reset "a3-core/$question" || true ;;
    esac
  done
}

ask_address_questions() {
  forget_retired_network
  for question in address gateway dns; do
    db_fset "a3-core/$question" seen false || true
    db_input high "a3-core/$question" || true
  done
  db_input medium a3-core/interface || true
  db_go || return 1
}

# The other wired socket on this machine, to offer for the audio network:
# physical, not Wi-Fi, not the one already configured. Empty if there is none.
other_wired_interface() {
  primary="$1"
  sysnet="${2:-/sys/class/net}"
  for path in "$sysnet"/*; do
    name=$(basename "$path")
    [ "$name" = "$primary" ] && continue
    [ -e "$path/device" ] || continue
    [ -e "$path/wireless" ] && continue
    [ -e "$path/phy80211" ] && continue
    echo "$name"
    return 0
  done
}

# Write the network for systemd-networkd into $dir: the first socket with the
# Core's address, gateway and DNS in 10-a3.network, and -- with a second
# socket -- the audio network (AES67, PTP) in 20-a3-aes67.network: a subnet of
# its own without gateway, so a reply always leaves by the socket it came in
# on. Two networks, not a bridge: with the bridge (2026-09-25 to 2026-10-14)
# every carrier drop on one socket cost both some thirty seconds of STP. The
# bridge files and the old single a3.network are retired, so an upgrade is
# also the way out of the bridge. Nothing is switched here: networkd reads
# the files at the next boot.
write_network_config() {
  dir="$1"; iface="$2"; addr="$3"; gateway="$4"; dns="$5"
  audio_port="$6"; audio_addr="$7"
  mkdir -p "$dir"

  # Only a unit whose content changes is written, and the one it replaces --
  # or removes -- is kept beside it as <name>.bak-<time>, a name networkd does
  # not read: a wrong write can be undone (a3-core#68).
  stamp="$(date +%Y%m%d-%H%M%S)"
  put_unit () {
    tmp="$(mktemp "$1.XXXXXX")"
    printf '%s\n' "$2" > "$tmp"
    if cmp -s "$tmp" "$1"; then
      rm -f "$tmp"
      return 0
    fi
    if [ -e "$1" ]; then
      cp -p "$1" "$1.bak-$stamp"
    fi
    chmod 644 "$tmp"
    chown root:root "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$1"
  }
  retire_unit () {
    [ -e "$1" ] || return 0
    mv -f "$1" "$1.bak-$stamp"
  }

  put_unit "$dir/10-a3.network" "[Match]
Name=${iface}

[Network]
Address=${addr}
Gateway=${gateway}
DNS=${dns}"

  if [ -n "$audio_port" ]; then
    put_unit "$dir/20-a3-aes67.network" "[Match]
Name=${audio_port}

[Network]
# AES67 and PTP in a subnet of their own: one subnet per port, so a reply
# always leaves by the port it came in on.
# No gateway and no DNS here: the only way out is the first socket.
Address=${audio_addr}"
  else
    retire_unit "$dir/20-a3-aes67.network"
  fi

  retire_unit "$dir/a3.network"
  retire_unit "$dir/10-a3-bridge.netdev"
  retire_unit "$dir/20-a3-bridge-ports.network"
  retire_unit "$dir/30-a3-bridge-address.network"
}

# The socket and the address for the audio network; an empty socket is none.
# Asked on every install like the address. The socket is pre-filled with the
# other wired one only the first time it is ever asked -- after that the
# stored answer stands, an empty one included, so a Core set to "none" is not
# talked back into one.
ask_audio_questions() {
  db_fget a3-core/audio-port seen || true
  if [ "x$RET" != "xtrue" ]; then
    db_set a3-core/audio-port "$(other_wired_interface "$1")" || true
  fi
  db_fset a3-core/audio-port seen false || true
  db_input high a3-core/audio-port || true
  db_fset a3-core/audio-address seen false || true
  db_input high a3-core/audio-address || true
  db_go || return 1
}

# Whether the a3-system installer answered the network questions. It preseeds
# its answers together with a3-core/preseeded=true; the marker is cleared here
# whatever it says, so it counts for this one install only. The `seen` flag is
# no such sign: package 1.0.0 showed configure-network itself, and the seen
# flag it left behind passed for the installer's answer -- an upgrade then
# rewrote the network unasked (a3-core#68).
installer_answered_network() {
  db_get a3-core/preseeded || true
  answered="$RET"
  db_set a3-core/preseeded false || true
  [ "x$answered" = "xtrue" ]
}

# Ask whether to configure network. High: at medium a fresh machine never saw
# it, took the default (no) and got no network at all. Asked every time, with
# no as the answer offered: debconf would offer the stored answer and skip a
# seen question, and one "yes" walked every later install through the whole
# network setup again (2026-10-01). Enter leaves the network as it is.
# Fails on ESC.
ask_configure_network() {
  db_reset a3-core/configure-network || true
  db_fset a3-core/configure-network seen false || true
  db_input high a3-core/configure-network || true
  db_go || return 1
}

# The steps below need root or the user's real home; they are functions of
# their own so the tests can stand in for them.
#
# The maintainer's network (hosts, Core's interface): created once from the
# package's defaults, never overwritten -- it is his to edit (spec
# truth-from-core).
create_network_file() {
  sudo -u "$APPUSER" -H /usr/bin/a3-core --render-truth network-file \
    || echo "a3-core: could not create ~/.config/a3/network.json" >&2
}

# INTERFACE, ADDR, GATEWAY, DNS, AUDIO_PORT and AUDIO_ADDR as shell assignments, from the
# truth joined with the user's ~/.config/a3/network.json (not root's: this
# runs as root).
render_default_network() {
  A3_NETWORK="${USER_HOME}/.config/a3/network.json" /usr/bin/a3-core --render-truth network
}

# Enable systemd-networkd but do NOT start it: the files take effect at boot.
enable_networkd() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable systemd-networkd.service || true
  fi
}

network_left() {
  echo "a3-core: network setup left (ESC), the network is as it was"
}

# The network step: the installer's marked answers, or asked here. ESC in any
# of its dialogs leaves it without writing anything -- no unit, no ifupdown
# edit, no network.json -- and the rest of the postinst carries on.
# network.json is created only for the default network, which is what it
# describes: asked answers are not in it, and a network left alone gets none
# (it used to be created on every install, naming eno1, a second socket and
# .10 on machines that had none of them).
network_step() {
  netdir="$1"; interfaces="$2"
  if installer_answered_network; then
    preseeded=true
  else
    preseeded=false
    if ! ask_configure_network; then
      network_left
      return 0
    fi
  fi
  db_get a3-core/configure-network
  configure="$RET"
  db_fset a3-core/configure-network seen false || true
  [ "x$configure" = "xtrue" ] || return 0

  db_get a3-core/install-default-network
  if [ "x$RET" = "xtrue" ]; then
    create_network_file
    eval "$(render_default_network)"
  else
    if [ "$preseeded" = false ] && ! ask_address_questions; then
      network_left
      return 0
    fi
    db_get a3-core/interface; INTERFACE="$RET"
    db_get a3-core/address; ADDR="$RET"
    db_get a3-core/gateway; GATEWAY="$RET"
    db_get a3-core/dns; DNS="$RET"

    if [ "$preseeded" = false ] && ! ask_audio_questions "$INTERFACE"; then
      network_left
      return 0
    fi
    db_get a3-core/audio-port; AUDIO_PORT="$RET"
    db_get a3-core/audio-address; AUDIO_ADDR="$RET"
  fi

  write_network_config "$netdir" "$INTERFACE" "$ADDR" "$GATEWAY" "$DNS" \
    "$AUDIO_PORT" "$AUDIO_ADDR"

  disable_ifupdown_for "$INTERFACE" "$interfaces"
  if [ -n "$AUDIO_PORT" ]; then
    disable_ifupdown_for "$AUDIO_PORT" "$interfaces"
  fi
  enable_networkd
}

network_step /etc/systemd/network /etc/network/interfaces

# Ask whether this Core runs without a monitor. High, not medium: Debian shows
# high and above by default, and the wrong default here is a black screen.
db_input high a3-core/headless-display || true
db_go || true
db_get a3-core/headless-display
apply_headless_choice "$RET" \
  "${USER_HOME}/.local/share/a3-core/x11/10-headless.conf" \
  /etc/X11/xorg.conf.d/10-headless.conf

# Continue with original postinst tasks (chown, enable services, etc.)
# --- existing operations start ---
# (preserve previous behavior; adjust below if your original postinst differs)

mkdir -p /home/aaa/.config
SHIPPED_CONFIG="${USER_HOME}/.local/share/a3-core/config"
user_systemctl() {
  sudo -u "$APPUSER" env XDG_RUNTIME_DIR="/run/user/$UID" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID/bus" systemctl --user "$@"
}

REPLACE_CONFIG=""
DIFFERING="$(differing_config_groups "$SHIPPED_CONFIG" "${USER_HOME}/.config")"
if [ -n "$DIFFERING" ]; then
  ask_replace_question "$DIFFERING"
fi

# The postinst restarts nothing of the rig: a running unit keeps its old
# config until it is restarted. The maintainer restarts a3-main himself after
# an upgrade.
CONFIG_BACKUP="${USER_HOME}/.config/a3-replaced/$(date +%Y-%m-%d_%H%M%S)"
install_shipped_config "$SHIPPED_CONFIG" "${USER_HOME}/.config" "$CONFIG_BACKUP" "$REPLACE_CONFIG"
retire_checkout_analyzer_unit "${USER_HOME}/.config" "$CONFIG_BACKUP"
RETIRED_UNITS=""
retire_jack_and_zita_units "${USER_HOME}/.config" "$CONFIG_BACKUP"
retire_reaper_files "${USER_HOME}/.config" "$CONFIG_BACKUP"
retire_core_script_drop_ins "${USER_HOME}/.config" "$CONFIG_BACKUP"
move_aside_unit_copies "${USER_HOME}/.config/systemd/user"
echo "a3-core: nothing restarted; restart a3-main to run the new config"

ssh_key_step "${USER_HOME}/.ssh"

# startx runs ~/.xserverrc as the X server: Xorg alone goes to CPU 0 (see the
# shipped file). A ~/.xserverrc that is not ours is somebody's own: kept, named.
install_xserverrc() {
  shipped="$1"; target="$2"
  if [ -e "$target" ] && ! cmp -s "$shipped" "$target" \
     && ! grep -q '^# a3-core: X server for startx' "$target"; then
    echo "a3-core: kept the local $target -- Xorg is not pinned to CPU 0"
    return 0
  fi
  cp "$shipped" "$target" && chmod 755 "$target" \
    || echo "a3-core: could not install $target -- Xorg is not pinned to CPU 0" >&2
}

install_xserverrc "${USER_HOME}/.local/share/a3-core/xserverrc" "${USER_HOME}/.xserverrc"

chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.local" || true
chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.config" || true
[ -f "${USER_HOME}/.xserverrc" ] && chown "${APPUSER}:${APPUSER}" "${USER_HOME}/.xserverrc" || true
[ -d "${USER_HOME}/.ssh" ] && chown -R "${APPUSER}:${APPUSER}" "${USER_HOME}/.ssh" || true

# x11vnc's port and the beat-analyzer's targets, from a3-osc.json. A failure
# is said out loud: they would start without their addresses.
sudo -u "$APPUSER" -H /usr/bin/a3-core --render-truth user \
  || echo "a3-core: a3-core --render-truth user failed -- x11vnc and the analyzer lack their addresses" >&2

find "$USER_HOME/.config" -type d -exec chmod 0755 {} \;
find "$USER_HOME/.config" -type f -exec chmod 0664 {} \;

if [ -d /home/aaa/.ssh ]; then
  chmod 0700 /home/aaa/.ssh
  find /home/aaa/.ssh -type f -exec chmod 0600 {} \;
fi

echo "enable system services..."
systemctl daemon-reload || true
systemctl enable x11vnc.service || true
# Start it now too: enabling alone left VNC off until the next reboot (2026-10-06).
systemctl restart x11vnc.service || true
systemctl enable set_irq_prio.service || true

# Set up aaa's side in aaa's user manager: stop what was retired, enable the
# rig and AES67. Linger only starts that manager -- asynchronously -- and
# taking linger away stops it when aaa has no session: a step run in it died
# two seconds in and was never started again, since apt doesn't rerun the
# postinst for the same version (a3-core#70). So the manager is started and
# waited for, the steps run to their end, and only then is linger taken away
# -- unless it was on before; the rig starts its services from the autologin
# session, not linger.
run_user_install() {
  linger_before="$(loginctl show-user "$APPUSER" -p Linger --value 2>/dev/null || echo no)"
  loginctl enable-linger "$APPUSER" || true
  systemctl start "user@${UID}.service" || true
  if user_systemctl daemon-reload; then
    stop_retired_units
    enable_the_rig
    enable_aes67
  else
    echo "a3-core: no user manager for $APPUSER -- the rig is not enabled; run 'dpkg-reconfigure a3-core'" >&2
  fi
  [ "x$linger_before" = "xyes" ] || loginctl disable-linger "$APPUSER" || true
}

# a3-main wants the engine, Core, the window, the analyzer, Motion and deck A:
# enabled, the rig comes up at the next login, and the bar with it. Both used
# to be enabled by links the deployment copied into ~/.config; the units ship
# under /usr/lib/systemd/user now and come without links. The screencast stays
# each machine's choice, and a3-core is pulled in by a3-main.
enable_the_rig() {
  user_systemctl enable a3-main.service || true
  user_systemctl enable a3-bar-per-workspace.service || true
}

# The audio network's socket, from the truth joined with network.json --
# the one place it is named; empty on a machine without one.
audio_port() {
  (
    eval "$(render_default_network)"
    printf '%s' "${AUDIO_PORT:-}"
  )
}

# AES67 and PTP on the audio socket: ptp4l@<port> (linuxptp's unit, run with
# /etc/linuxptp/a3-ptp4l.conf by a drop-in: master, steps clients, never steers
# its own clock), the AES67 instance in aaa's user manager, the clock role
# that steers the PTP clock from the Scarlett (a3-clock.service, a3-core-app's)
# and the root timer that hands it ptp4l's port state (a3-ptp-state.timer).
# Enabled, not started: they come up with the next boot or login. Without an
# audio socket none is enabled.
enable_aes67() {
  port="$(audio_port)"
  if [ -z "$port" ]; then
    echo "a3-core: no audio port in the network -- AES67 and PTP not enabled"
    user_systemctl disable a3-aes67.service || true
    user_systemctl disable a3-clock.service || true
    systemctl disable a3-ptp-state.timer || true
    return 0
  fi
  systemctl enable "ptp4l@${port}.service" || true
  systemctl enable a3-ptp-state.timer || true
  user_systemctl enable a3-aes67.service || true
  user_systemctl enable a3-clock.service || true
}

# The engine role's user unit, which a3-core-app ships, enabled for every
# user here: the Core machine's package enables it, the app enables nothing
# (a laptop starts its units by hand or from the Canvas). Before aaa's user
# manager is started and a3-main enabled below, so that manager already sees
# the unit. No restart: a running engine keeps its old binary until its next start.
if [ "$1" = "configure" ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --global enable a3-engine.service || true
  # Every running user manager learns of the new unit file. Only a reload: reaching
  # a user manager needs its user's name, which loginctl gives here.
  for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
    systemctl --user --machine="$user@" daemon-reload 2>/dev/null || true
  done
fi

echo "enable userservices..."
run_user_install

echo "update grub..."
update-grub || true

echo "Installation complete."
echo "use 'systemctl --user status a3-main.service' to check the rig"
echo "use 'dpkg-reconfigure a3-core' to configure network and the headless screen"
echo "Please Reboot or manage a3-core manually with 'systemctl --user start a3-main.service'"
