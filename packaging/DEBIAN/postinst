#!/bin/sh
set -e

# Debconf helper
if [ -f /usr/share/debconf/confmodule ]; then
  . /usr/share/debconf/confmodule
fi
# ESC (back) in a dialog comes back from db_go as 30 instead of being taken as
# the pre-filled answer. The network step leaves on it (a3-core#68).
db_capb backup

APPUSER="aaa"
UID=$(id -u $APPUSER)
USER_HOME=$(getent passwd "$APPUSER" | cut -d: -f6 || echo "/home/$APPUSER")

# Put back the authorized_keys the preinst kept aside, when the unpack took it
# (older versions shipped the file, a3-core#66). A file that is there is the
# machine's and stays; the copy goes either way. Never through a symlink: root
# would write wherever aaa pointed it. Runs before anything that can fail, so
# a failed upgrade never leaves a machine run over ssh without its keys.
KEPT_KEYS=/var/lib/a3-core/authorized_keys.keep

restore_authorized_keys() {
  ssh_dir="$1"
  kept="$2"
  owner="$3"
  [ -f "$kept" ] || return 0
  if [ -L "$ssh_dir" ] || [ -L "$ssh_dir/authorized_keys" ]; then
    echo "a3-core: $ssh_dir is behind a symlink; the old keys stay in $kept" >&2
    return 0
  fi
  if [ -e "$ssh_dir/authorized_keys" ]; then
    rm -f "$kept"
    return 0
  fi
  if [ ! -d "$ssh_dir" ]; then
    mkdir -p "$ssh_dir"
    chmod 700 "$ssh_dir"
    chown "$owner" "$ssh_dir"
  fi
  mv "$kept" "$ssh_dir/authorized_keys"
}

restore_authorized_keys "${USER_HOME}/.ssh" "$KEPT_KEYS" "$APPUSER"

# <user> into <group>, unless it is in already. Takes effect at the next login.
join_group() {
  case " $(id -nG "$2") " in
    *" $1 "*) return 0 ;;
  esac
  usermod -aG "$1" "$2"
}

# limits.d/audio.conf gives @audio realtime priority; on the rig aaa was put in
# the group by hand, on a fresh machine nobody did (a3-core#65).
join_audio_group() {
  join_group audio "$1"
}

# The clock role (a3-clock.service) steers the PTP hardware clock from the
# Scarlett; /dev/ptp* is root:clock 0664 on Debian, so the group is the write
# access, no capability. A system without the group is left alone.
join_clock_group() {
  getent group clock >/dev/null || return 0
  join_group clock "$1"
}

join_audio_group "$APPUSER"
join_clock_group "$APPUSER"

# Take an interface out of ifupdown's hands, so systemd-networkd is the only
# thing that configures it. With both, /etc/network/interfaces' DHCP stanza and
# a3.network's static address claimed the same interface, and the address the
# machine came up with depended on which one was first (a3-core issue #54).
# Comments the lines out rather than deleting them, so the change can be read
# and undone. Idempotent: a commented line no longer matches.
disable_ifupdown_for() {
  iface="$1"
  file="$2"
  [ -f "$file" ] || return 0
  sed -i \
    -e "s/^\([[:space:]]*\(allow-hotplug\|auto\)[[:space:]]\+${iface}[[:space:]]*\)$/# a3-core: networkd owns ${iface} -- \1/" \
    -e "s/^\([[:space:]]*iface[[:space:]]\+${iface}[[:space:]].*\)$/# a3-core: networkd owns ${iface} -- \1/" \
    "$file"
}

# Put X on the dummy screen, or take it off again. The config used to ship as
# an active conffile, which on a machine with a screen is a black monitor with
# everything running behind it -- and dpkg re-installs a conffile that is new
# to the package even where somebody had moved it aside (a3-core issue #53).
# "No" takes the shipped config out of X by renaming it, which mends a machine
# the old package left it on; a config somebody wrote themselves is left alone.
apply_headless_choice() {
  choice="$1"
  shipped="$2"
  target="$3"
  if [ "x$choice" = "xtrue" ]; then
    mkdir -p "$(dirname "$target")"
    cp "$shipped" "$target"
    return 0
  fi
  if [ -f "$target" ] && cmp -s "$shipped" "$target"; then
    mv -f "$target" "$target.off"
  fi
}

# One public key, given at install time (a3-core/ssh-key), appended to the
# keys already there. Anything but a single public-key line is refused without
# failing the install; options such as command="..." are left to the hand.
install_ssh_key() {
  ssh_dir="$1"
  key="$(printf '%s' "$2" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
  [ -n "$key" ] || return 0
  if [ "$(printf '%s\n' "$key" | wc -l)" -ne 1 ] || ! printf '%s\n' "$key" | grep -Eq \
      '^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) AAAA[A-Za-z0-9+/]+={0,3}( .*)?$'; then
    echo "a3-core: the answer to a3-core/ssh-key is not a public key; no key added" >&2
    return 0
  fi
  keys="$ssh_dir/authorized_keys"
  if [ -L "$ssh_dir" ] || [ -L "$keys" ]; then
    echo "a3-core: $keys is behind a symlink; no key added" >&2
    return 0
  fi
  mkdir -p "$ssh_dir"
  chmod 700 "$ssh_dir"
  # The same key under another comment, or with options in front, is the same key.
  body="$(printf '%s\n' "$key" | cut -d' ' -f2)"
  if [ -f "$keys" ] && awk -v body="$body" '{ for (i = 1; i <= NF; i++) if ($i == body) found = 1 } END { exit !found }' "$keys"; then
    return 0
  fi
  if [ -s "$keys" ] && [ -n "$(tail -c1 "$keys")" ]; then
    echo >> "$keys"
  fi
  printf '%s\n' "$key" >> "$keys"
  chmod 600 "$keys"
}

# Ask for the key, add it, then forget the answer: an upgrade must not put
# back a key somebody has since removed by hand.
ssh_key_step() {
  db_input high a3-core/ssh-key || true
  db_go || true
  db_get a3-core/ssh-key
  install_ssh_key "$1" "$RET"
  db_set a3-core/ssh-key "" || true
}

# The parts of the shipped config the replace question offers, by the top
# folder a file sits in. Parts, not files: a3nuc2 alone had eleven files that
# differed, and a list of files runs past a screen.
config_group() {
  case "$1" in
    i3/*)         echo i3 ;;
    systemd/*)    echo systemd ;;
    pipewire/*)   echo pipewire ;;
    *)            echo other ;;
  esac
}

config_group_label() {
  case "$1" in
    i3)       echo "i3 config" ;;
    systemd)  echo "systemd user units" ;;
    pipewire) echo "PipeWire: rate + block + AES67" ;;
    *)        echo "other files" ;;
  esac
}

# The parts with at least one file that is there and differs from the shipped
# one, in debconf's list form ("i3, systemd") and always in the same order. A
# file that is not there yet is not in it: installing it replaces nothing, so
# there is nothing to ask.
differing_config_groups() {
  src="$1"; dst="$2"
  found="$(find "$src" -type f | while IFS= read -r shipped; do
    rel="${shipped#"$src"/}"
    [ -e "$dst/$rel" ] || continue
    cmp -s "$shipped" "$dst/$rel" && continue
    config_group "$rel"
  done)"
  for g in i3 systemd pipewire other; do
    echo "$found" | grep -qx "$g" && echo "$g"
  done | paste -sd, - | sed 's/,/, /g'
}

# Whether $1 is in the debconf list $2 ("i3, systemd").
in_list() {
  case ", $2," in
    *", $1,"*) return 0 ;;
  esac
  return 1
}

# Put the shipped config in place, file by file. It used to be `cp -rn`, which
# never replaced anything: a Core set up from a home with an older a3 in it
# kept its old i3 config and user units (and, then, REAPER's template), and a new
# package changed nothing (a3nuc2, 2026-10-04). A file that is missing is
# installed. One that differs is replaced only if its part is in $replace --
# the answer to a3-core/replace-config -- and is copied to $backup first,
# keeping its path, and named: a local edit is replaced but neither lost nor
# silent. One whose part was not chosen stays, and is named too.
install_shipped_config() {
  src="$1"; dst="$2"; backup="$3"; replace="$4"
  find "$src" -type f | while IFS= read -r shipped; do
    rel="${shipped#"$src"/}"
    target="$dst/$rel"
    cmp -s "$shipped" "$target" && continue
    if [ -e "$target" ]; then
      if ! in_list "$(config_group "$rel")" "$replace"; then
        echo "a3-core: kept the local ~/.config/$rel"
        continue
      fi
      mkdir -p "$(dirname "$backup/$rel")"
      cp -p "$target" "$backup/$rel"
      echo "a3-core: replaced ~/.config/$rel (previous in $backup)"
    fi
    mkdir -p "$(dirname "$target")"
    cp "$shipped" "$target"
  done
}

# beat-analyzer.service as a3-core shipped it before the analyzer had its own
# package: it ran the checkout's build/, and in ~/.config it hides the
# package's unit in /usr/lib. Moved to the backup, not deleted. A unit of that
# name that does something else is somebody's own: kept, and named.
retire_checkout_analyzer_unit() {
  unit="$1/systemd/user/beat-analyzer.service"; backup="$2"
  package_unit="${3:-/usr/lib/systemd/user/beat-analyzer.service}"
  [ -f "$unit" ] || return 0
  if ! grep -q '^ExecStart=.*/beat-analyzer/build/beat-analyzer' "$unit"; then
    echo "a3-core: kept the local ~/.config/systemd/user/beat-analyzer.service -- it hides the beat-analyzer package's unit"
    return 0
  fi
  if [ ! -f "$package_unit" ]; then
    echo "a3-core: kept ~/.config/systemd/user/beat-analyzer.service (it runs the checkout) -- the beat-analyzer package is not installed"
    return 0
  fi
  if mkdir -p "$backup/systemd/user" 2>/dev/null \
     && mv "$unit" "$backup/systemd/user/beat-analyzer.service"; then
    echo "a3-core: moved ~/.config/systemd/user/beat-analyzer.service (it ran the checkout) to $backup"
  else
    echo "a3-core: could not move ~/.config/systemd/user/beat-analyzer.service -- it still hides the package's unit" >&2
  fi
}

# a3-jack, zita-j2n and zita-n2j as earlier versions of the package shipped
# them: PipeWire and AES67 replaced them (2026-10-14), and left enabled in
# ~/.config an old unit would start jackd and take the sound card away from
# PipeWire. Disabled (their links in the .wants folders) and moved to the
# backup, not deleted. Only the Core's own -- the ones that run jackd or zita
# itself; StemDeck's zita units of the same names stay, and are named. Their
# names are collected in RETIRED_UNITS, to be stopped once aaa's manager is up.
retire_jack_and_zita_units() {
  units_dir="$1/systemd/user"; backup="$2"
  for name in a3-jack.service zita-j2n.service zita-n2j.service; do
    unit="$units_dir/$name"
    [ -f "$unit" ] || continue
    case "$name" in
      a3-jack.service) program=/usr/bin/jackd ;;
      *)               program="/usr/bin/${name%.service}" ;;
    esac
    if ! grep -Eq "^ExecStart=${program}( |\$)" "$unit"; then
      echo "a3-core: kept the local ~/.config/systemd/user/$name -- not the Core's"
      continue
    fi
    if mkdir -p "$backup/systemd/user" 2>/dev/null \
       && mv "$unit" "$backup/systemd/user/$name"; then
      find "$units_dir" -mindepth 2 -maxdepth 2 -type l -path "*.wants/$name" \
        -exec rm -f {} + || true
      RETIRED_UNITS="${RETIRED_UNITS:+$RETIRED_UNITS }$name"
      echo "a3-core: moved ~/.config/systemd/user/$name (jackd and zita are gone) to $backup"
    else
      echo "a3-core: could not move ~/.config/systemd/user/$name -- it may still start" >&2
    fi
  done
}

# REAPER, its patchbay and qjackctl as earlier versions of the package
# shipped them: the a3-core program replaced REAPER (2026-10-27). dpkg deletes
# ~/.local/bin/a3-engine-runs with the package, but the drop-ins in ~/.config
# that call it are this machine's copies and stay -- and a drop-in whose
# ExecCondition calls a missing helper keeps its unit (deck A) from starting.
# So the three units are disabled (their links in the .wants folders) and
# moved to the backup with their drop-in folders, every drop-in that names the
# helper, and the patchbay; each is named, nothing is deleted. Their names go
# to RETIRED_UNITS, to be stopped once aaa's manager is up. REAPER's own files
# -- ~/.config/REAPER, ~/.local/opt, ~/.local/vst, ~/.local/clap -- are never
# touched: they are the maintainer's to remove by hand.
retire_reaper_files() {
  config="$1"; backup="$2"
  units_dir="$config/systemd/user"
  # ~/.config/$1, a file or a folder, to the same path in the backup; named.
  move_to_backup() {
    if mkdir -p "$(dirname "$backup/$1")" 2>/dev/null \
       && mv "$config/$1" "$backup/$1"; then
      echo "a3-core: moved ~/.config/$1 (REAPER and qjackctl are gone) to $backup"
      return 0
    fi
    echo "a3-core: could not move ~/.config/$1 -- it is still in place" >&2
    return 1
  }
  for name in a3-reaper.service qjackctl.service a3-user-install.service; do
    [ -f "$units_dir/$name" ] || continue
    if move_to_backup "systemd/user/$name"; then
      find "$units_dir" -mindepth 2 -maxdepth 2 -type l -path "*.wants/$name" \
        -exec rm -f {} + || true
      RETIRED_UNITS="${RETIRED_UNITS:+$RETIRED_UNITS }$name"
    fi
  done
  for folder in a3-reaper.service.d qjackctl.service.d; do
    [ -d "$units_dir/$folder" ] || continue
    move_to_backup "systemd/user/$folder" || true
  done
  for drop_in in "$units_dir"/*.service.d/*.conf; do
    [ -f "$drop_in" ] || continue
    grep -q 'a3-engine-runs' "$drop_in" || continue
    move_to_backup "${drop_in#"$config"/}" || true
  done
  for file in rncbc.org/a3-patchbay.xml rncbc.org/QjackCtl.conf; do
    [ -f "$config/$file" ] || continue
    move_to_backup "$file" || true
  done
}

