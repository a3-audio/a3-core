[Unit]
Description=the a3-core window
PartOf=a3-main.service
# The window attaches to the Core and the engine that are already up and never spawns them here.
After=a3-core.service a3-engine.service

[Service]
# The display by name and the screen awaited here, as a3-reaper.service does. The helper is
# a3-core's (its package installs it into ~/.local/bin); this package does not ship it.
Environment=DISPLAY=:0
ExecStartPre=%h/.local/bin/a3-wait-for-the-screen
# No role: the window. It exits 0 when it is closed (also after the quit question) and on SIGTERM,
# so on-failure leaves a closed window closed; a crash or a kill signal starts it again.
ExecStart=/usr/bin/a3-core
Restart=on-failure
RestartSec=2

# No install section and no conflict line: a3-main Wants this unit, and a conflict between units in one
# transaction drops a start job before any condition runs.
