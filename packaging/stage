#!/usr/bin/env bash
# a3-core's recipe for its Debian package (a3-core: the program and the
# deployment payload), called by a3-system's installer/package.py from an
# exported tree (git archive):
#
#   packaging/stage build <src> <build> <juce-prefix> <jobs> [--test]
#   packaging/stage files <src> <build> <stage>
set -euo pipefail

usage() {
    echo "usage: $0 build <src> <build> <juce> <jobs> [--test] | files <src> <build> <stage>" >&2
    exit 2
}

build() {
    [[ $# -eq 4 || ( $# -eq 5 && "$5" == --test ) ]] || usage
    local src=$1 build=$2 juce=$3 jobs=$4 test=${5:-}
    local tests=OFF
    [[ "$test" == --test ]] && tests=ON
    cmake -S "$src" -B "$build" -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_PREFIX_PATH="$juce" -DA3_ENGINE_TESTS="$tests" -DA3_ENGINE_BENCH=ON
    cmake --build "$build" -j "$jobs"
    [[ "$tests" == ON ]] && ctest --test-dir "$build" --output-on-failure
    return 0
}

files() {
    [[ $# -eq 3 ]] || usage
    local src=$1 build=$2 stage=$3
    install_payload "$src" "$stage"
    install -D -m 755 "$build/app/a3-core" "$stage/usr/bin/a3-core"
    install -D -m 755 "$build/bench/a3-engine-bench" "$stage/usr/bin/a3-engine-bench"
    install -D -m 644 "$src/packaging/a3-engine.service" "$stage/usr/lib/systemd/user/a3-engine.service"
    install -D -m 644 "$src/packaging/a3-core-window.service" "$stage/usr/lib/systemd/user/a3-core-window.service"
    install -D -m 644 "$src/data/engine.json" "$stage/usr/share/a3-engine/engine.json"
    install_spatial_data "$src" "$stage"
    install_copyright "$src" "$stage"
}

# The deployment tree as it is in git, modes kept. First, so the program's files are laid
# over it and a payload file can never shadow /usr/bin/a3-core.
install_payload() {
    local src=$1 stage=$2
    mkdir -p "$stage"
    cp -a "$src/platform-config/debian-x86_64/a3-core/." "$stage/"
}

# The app's and the bench's package default is spatial/ (engine.json names it relative to itself); the 6.1 booth is REAPER's, for the parity run (--spatial).
install_spatial_data() {
    local src=$1 stage=$2 directory file
    for directory in spatial spatial-reaper-booth-6.1; do
        for file in "$src/data/$directory"/*.json; do
            install -D -m 644 "$file" "$stage/usr/share/a3-engine/$directory/$(basename "$file")"
        done
    done
}

# .reuse/dep5 is already in Debian's machine-readable copyright format; its stanzas name MIT,
# CC-BY-3.0, Apache-2.0 and CC-BY-SA-4.0, so the copyright file must carry their texts as License
# paragraphs (copyright-format 1.0: text indented one space, blank lines as " ."). The GPL and
# CC0 texts are referenced through /usr/share/common-licenses, as Debian does.
install_copyright() {
    local src=$1 stage=$2 license
    local copyright="$stage/usr/share/doc/a3-core/copyright"
    install -D -m 644 "$src/.reuse/dep5" "$copyright"
    for license in MIT CC-BY-3.0 Apache-2.0 CC-BY-SA-4.0; do
        {
            printf '\nLicense: %s\n' "$license"
            sed -e 's/^$/./' -e 's/^/ /' "$src/LICENSES/$license.txt"
        } >> "$copyright"
    done
}

case "${1:-}" in
    build) shift; build "$@" ;;
    files) shift; files "$@" ;;
    *) usage ;;
esac
