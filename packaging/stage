#!/usr/bin/env bash
# a3-core's recipe for its Debian package (a3-core: the Core machine's
# deployment around the program, which a3-core-app carries -- packaging/app),
# called by a3-system's installer/package.py from an exported tree (git archive):
#
#   packaging/stage build <src> <build> <juce-prefix> <jobs> [--test]
#   packaging/stage files <src> <build> <stage>
set -euo pipefail

. "$(dirname "$(readlink -f "$0")")/copyright.sh"

PACKAGE=a3-core
#: Kept in the deployment tree in git, shipped by a3-core-app (packaging/app/stage).
PROGRAM_FILES_IN_PAYLOAD=(usr/share/a3/a3-osc.json)

usage() {
    echo "usage: $0 build <src> <build> <juce> <jobs> [--test] | files <src> <build> <stage>" >&2
    exit 2
}

# Nothing to compile: the program is a3-core-app's.
build() {
    [[ $# -eq 4 || ( $# -eq 5 && "$5" == --test ) ]] || usage
    return 0
}

files() {
    [[ $# -eq 3 ]] || usage
    local src=$1 stage=$3
    install_payload "$src" "$stage"
    install_copyright "$src" "$stage" "$PACKAGE"
}

# The deployment tree as it is in git, modes kept, without the program's files:
# two packages owning one path would refuse to install side by side.
install_payload() {
    local src=$1 stage=$2 relative
    mkdir -p "$stage"
    cp -a "$src/platform-config/debian-x86_64/a3-core/." "$stage/"
    for relative in "${PROGRAM_FILES_IN_PAYLOAD[@]}"; do
        rm -f "$stage/$relative"
    done
    find "$stage" -depth -type d -empty -delete
}

case "${1:-}" in
    build) shift; build "$@" ;;
    files) shift; files "$@" ;;
    *) usage ;;
esac
