[Unit]
Description=a3-core (the a3-core program's core role)
PartOf=a3-main.service
# The audio server comes first; Core reaching the void for a moment costs nothing.
After=pipewire.service wireplumber.service

# The Core role for any machine, the Core machine included: the one
# a3-core.service, shipped by a3-core-app. A machine that needs a different
# line puts a drop-in into ~/.config/systemd/user/a3-core.service.d/.
[Service]
# Idle: the window orders itself after this unit (a3-core-window.service).
Type=idle
PrivateTmp=true
ExecStart=/usr/bin/a3-core --role core

[Install]
WantedBy=default.target
