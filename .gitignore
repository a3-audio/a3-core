platform-config/debian-x86_64/a3-core.deb
*.swp

# Python-Bytecode. Er wird beim ersten Lauf erzeugt, ist an die
# Interpreter-Version gebunden und gehört keinem Repository.
__pycache__/
*.py[cod]

# A VNC password is made on the machine (x11vnc -storepasswd) and is nobody
# else's: never in the package, never in a commit.
.vnc/

# The C++ program's build trees.
build/
build-*/
