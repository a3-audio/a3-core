  {"at": 0.65, "from": ["192.168.8.11", 50001], "osc": ["/channel/3/azimuth", ["s", "45"]]},
  {"at": 0.7, "from": ["192.168.8.11", 50001], "osc": ["/channel/3/cue", ["s", "1"]]},
  {"at": 0.75, "from": ["192.168.8.11", 50001], "osc": ["/channel/1/stem/turn", ["s", "-1"]]},
  {"at": 0.8, "from": ["192.168.8.11", 50001], "osc": ["/channel/1/stem/push", ["s", "1"]]},
  {"at": 0.85, "from": ["192.168.8.11", 50001], "osc": ["/filter/mode", ["s", "high_pass"]]},
  {"at": 0.9, "from": ["192.168.8.11", 50001], "osc": ["/master/phones-mix", ["s", "0.2"]]},
  {"at": 1.0, "from": ["127.0.0.1", 41000], "osc": ["/engine/hello", ["s", "boot-1"]]},
  {"at": 1.1, "tick": true},
  {"at": 3.2, "tick": true},
  {"at": 3.5, "flush": true}
 ]
